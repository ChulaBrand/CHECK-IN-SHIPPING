# Copia este archivo a .env y llena tus propios valores.
# .env nunca se sube a git (ver .gitignore).

# Local con `npm run dev`: un archivo SQLite junto al proyecto.
# Con Docker/docker-compose: se pisa automáticamente por la ruta del volumen
# (ver docker-compose.yml), no hace falta cambiarla aquí para eso.
DATABASE_URL="file:./dev.db"

# Contraseña compartida que usa el personal para entrar a /staff.
STAFF_PASSWORD="cambia-esta-contraseña"

# Clave para encriptar la cookie de sesión del personal. Debe tener 32+
# caracteres. Genera una con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET="reemplaza-esto-con-una-cadena-aleatoria-de-32-caracteres-o-mas"
